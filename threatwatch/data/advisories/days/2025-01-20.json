        "CVE-2024-55565",
        "CVE-2024-56201",
        "CVE-2024-56326",
        "CVE-2024-56334"
      ],
      "sev": "HIGH",
      "cvss": 8.0,
      "fix": [
        {
          "t": "For more about Red Hat Developer Hub, see References links",
          "u": "https://access.redhat.com/errata/RHBA-2025:0409"
        },
        {
          "t": "Avoid using two parameters within a single path segment when the separator is not, for example, /:a-:b. Alternatively, you can define the regex used for both parameters and ensure they do not overlap to allow backtracking.",
